# Snagly 2.0 cloud configuration.
# Copy to .env and fill in real values. Never commit .env.
#
#   cp .env.example .env
#   openssl rand -base64 48   # use this output for SNAGLY_DOWNLOAD_SECRET

# Public HTTPS origin served by Cloudflare Tunnel. Required for secure cookies,
# Origin checks and absolute links.
SNAGLY_PUBLIC_ORIGIN=https://snagly.example.com

# Hostnames accepted in the Host header. Include the public hostname and any
# local health-check hostname you use. Comma-separated, lowercase.
SNAGLY_ALLOWED_HOSTS=snagly.example.com

# Cloudflare Tunnel forwards the real client IP in CF-Connecting-IP.
SNAGLY_TRUST_PROXY=true
SNAGLY_SECURE_COOKIES=true

# Generate once: openssl rand -base64 48
# Changing this invalidates outstanding download links, not sessions.
SNAGLY_DOWNLOAD_SECRET=

# Optional: cookies.txt exported from a signed-in YouTube account (Netscape
# format). Cloud/datacenter IPs get "Sign in to confirm you're not a bot",
# which cookies clear. Put the file at ./secrets/cookies.txt, then set the
# container path below. yt-dlp rewrites the file to refresh tokens, so it must
# be writable by the container user (uid 1000), readable only there:
# sudo chown 1000:1000 secrets/cookies.txt && sudo chmod 600 secrets/cookies.txt
# Cookies expire, so re-export when previews fail again.
# This file is a live login credential — never commit or share it.
SNAGLY_COOKIES_FILE=

# Optional override for the JS runtime used to solve YouTube challenges.
# Defaults to the Node binary running Snagly; leave this empty unless needed.
SNAGLY_JS_RUNTIME_PATH=

# Sessions and retention.
SNAGLY_SESSION_TTL_DAYS=30
SNAGLY_RETENTION_HOURS=24

# Limits. Tune for the size of the VM.
SNAGLY_GLOBAL_CONCURRENCY=4
SNAGLY_USER_CONCURRENCY=2
SNAGLY_MAX_PLAYLIST_ENTRIES=500
SNAGLY_MAX_TRACKS_PER_JOB=500
SNAGLY_MAX_JOBS_PER_USER=100
SNAGLY_MAX_QUEUED_TRACKS=300
SNAGLY_MAX_FILE_MB=4096
SNAGLY_MAX_JOB_MB=8192
SNAGLY_MAX_JOB_MINUTES=30
SNAGLY_MAX_BODY_BYTES=65536
SNAGLY_MAX_LINKS=20
SNAGLY_MAX_SSE=3
SNAGLY_PREVIEW_CACHE_ENTRIES=500
SNAGLY_THUMB_CACHE_MB=256

# Logging: debug, info, warn, error.
SNAGLY_LOG_LEVEL=info

# Compose host port (bound to 127.0.0.1 only).
SNAGLY_HOST_PORT=4174
SNAGLY_MEM_LIMIT=1g
SNAGLY_CPUS=1.5
SNAGLY_TMP_SIZE=512m

# Pinned media tool version for reproducible image builds.
YTDLP_VERSION=2026.11.23

# Cloudflare Tunnel token from the Zero Trust dashboard. Only needed when
# running the optional tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
